# Caddy gets and renews HTTPS certificates automatically.
# Both names reach the same Node process and database. ops.arenergyservices.in serves the Console
# from main; api.arenergyservices.in serves the app API (/api/) the same way, but its Console pages
# are the preview of the design-change branch (static files in /opt/ares-design, deploy/deploy-design.sh).

# Shared by both names: APK page, field web apps, Power Quality analyser, access log.
(ares_common) {
	encode gzip
	# AR apps download page and APKs (a copy of the public APK repo, see ar-apps-sync.sh).
	redir /apps /apps/
	handle_path /apps/* {
		@hidden path /.* */.*
		respond @hidden 404
		root * /var/www/ar-apps
		# Installed apps read apps.json to offer updates, from their own origin.
		header /apps.json Access-Control-Allow-Origin *
		header /apps.json Cache-Control "no-cache"
		header *.apk Content-Type application/vnd.android.package-archive
		file_server
	}
	# Field apps as web apps (PWAs), one folder each: /field/brief/, /field/mla/ … (deploy/field-web.sh).
	redir /field /#/apps
	handle_path /field/* {
		root * /opt/ar-field
		header /*/sw.js Cache-Control "no-cache"
		header /*/manifest.webmanifest Content-Type application/manifest+json
		header /*/_next/static/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} {path}/index.html {path}index.html
		file_server
	}
	# Power Quality analyser (repo ares-power): the web app at /pqa/, its server at /pqa/api/.
	# Analyser exports can be large, so only this path accepts big uploads.
	redir /pqa /pqa/
	handle /pqa/api/* {
		request_body {
			max_size 600MB
		}
		uri strip_prefix /pqa
		reverse_proxy 127.0.0.1:8091 {
			header_up X-Forwarded-For {remote_host}
			transport http {
				read_timeout 15m
				write_timeout 15m
			}
		}
	}
	handle_path /pqa/* {
		root * /opt/ares-power/web
		try_files {path} /index.html
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		file_server
	}
	log {
		output file /var/log/caddy/ares-access.log {
			roll_size 20MiB
			roll_keep 5
		}
	}
}

(ares_backend) {
	request_body {
		max_size 10MB
	}
	reverse_proxy 127.0.0.1:8080 {
		header_up X-Forwarded-For {remote_host}
	}
}

# The Console (main branch) and the app API.
ops.arenergyservices.in {
	import ares_common
	handle {
		import ares_backend
	}
}

# The app API, plus the Console pages from the design-change branch. Same server, same accounts
# and data: sign-in, every change and every sync go through /api/ exactly as on ops.
api.arenergyservices.in {
	import ares_common
	handle /api/* {
		import ares_backend
	}
	# The AI report connector (lib/mcp.js).
	handle /mcp {
		import ares_backend
	}
	handle {
		# The same headers the Node server sends with its pages (lib/http.js securityHeaders).
		header {
			Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
			X-Content-Type-Options nosniff
			X-Frame-Options DENY
			Referrer-Policy no-referrer
			X-Robots-Tag "noindex, nofollow"
			Permissions-Policy "camera=(), microphone=(), geolocation=()"
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			Cache-Control no-cache
		}
		@hidden path /.* */.*
		respond @hidden 404
		root * /opt/ares-design
		file_server
	}
}

# GST Billing: Free GST Billing Software (MIT, github.com/IamRamgarhia/Free-GST-Billing-Software),
# installed by deploy/billing.sh. Every request is checked by ARES first (lib/routes-billing.js):
# only Super Admins and Heads signed in to the Console get through.
billing.arenergyservices.in {
	encode gzip
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy no-referrer
		X-Robots-Tag "noindex, nofollow"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
	# Sign-in handoff from the Console, and signing out of billing.
	handle /_ares/* {
		rewrite /_ares/enter /api/billing/enter
		rewrite /_ares/signout /api/billing/signout
		reverse_proxy 127.0.0.1:8080
	}
	handle {
		route {
			# The app's icons and manifest can load before sign-in (browsers fetch them without cookies).
			@private not path /manifest.webmanifest /favicon.svg /icons/*
			forward_auth @private 127.0.0.1:8080 {
				uri /api/billing/check
			}
			# Parts meant for a desktop install: running update/restore scripts, opening folders,
			# backups to any folder. Off here; the server backs the data up (deploy/backup.sh).
			@desktop path /api/control-panel/launch-script /api/control-panel/backup /api/control-panel/open-* /api/backup-folder
			respond @desktop "Not available on the AR server." 403
			# No offline service worker: a cached copy would skip the sign-in check.
			@sw path /sw.js /registerSW.js /workbox-*.js
			respond @sw 404
			# The app accepts only localhost origins; requests from its own site are made to look local.
			@self header Origin https://billing.arenergyservices.in
			request_header @self -Origin
			request_body {
				max_size 60MB
			}
			reverse_proxy 127.0.0.1:47371
		}
	}
	log {
		output file /var/log/caddy/billing-access.log {
			roll_size 20MiB
			roll_keep 5
		}
	}
}
